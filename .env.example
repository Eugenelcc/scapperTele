# ---- Telegram ----
# Create a bot with @BotFather and paste the token here.
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token

# Your chat id. Message the bot once and it will reply with your chat id,
# or use @userinfobot. Scheduled deal alerts are pushed here.
# You can leave this blank and use /subscribe from within the chat instead.
TELEGRAM_CHAT_ID=

# ---- Scraping / scheduling ----
# How often (in hours) the background scan runs. Keep this modest (e.g. 12)
# to stay within your free scraping-API credits.
SCAN_INTERVAL_HOURS=12

# Comma-separated default searches used by the scheduled scan.
# Format:  query|maxPrice|keyword1;keyword2
# maxPrice and keywords are optional. Example below watches iPhone 15 under $900
# that mention "256" or "pro", and any MacBook Air.
DEFAULT_WATCHES=iphone 15|900|256;pro , macbook air|1400|

# Region host for Carousell (sg = Singapore).
CAROUSELL_HOST=www.carousell.sg

# ---- Scraping API (to get past Carousell's Cloudflare wall) ----
# Carousell blocks plain requests with Cloudflare, so fetches are routed
# through a scraping API. Sign up free at https://www.scraperapi.com and
# paste the key here. Without it, Carousell searches will return nothing.
SCRAPER_API_KEY=

# Which backend: scraperapi (default when a key is set) | scrapedo | direct
SCRAPER_PROVIDER=scraperapi

# Cloudflare needs JS rendering + premium residential proxies to pass.
# Turning these off is cheaper (fewer credits) but usually fails on Carousell.
SCRAPER_ULTRA_PREMIUM=true
SCRAPER_RENDER=true
SCRAPER_COUNTRY=sg

# ---- eBay source (free, official, no bot-wall) ----
# A reliable free source that always works. Create a free app at
# https://developer.ebay.com (Application Keys) and paste the Production
# App ID (Client ID) and Cert ID (Client Secret) here. Leave blank to disable.
EBAY_APP_ID=
EBAY_CERT_ID=
# Marketplace: EBAY_SG (Singapore), EBAY_US, EBAY_GB, EBAY_AU, ...
# If EBAY_SG returns errors for your account, try EBAY_US.
EBAY_MARKETPLACE=EBAY_SG
# production | sandbox
EBAY_ENV=production

# Max results fetched per query per source.
MAX_RESULTS=40

# ---- Server ----
# Render provides PORT automatically. Locally defaults to 10000.
PORT=10000

# Optional: a shared secret. If set, GET /scan?token=... triggers a scan on demand.
SCAN_TOKEN=

# ---- Telegram Mini App (web view) ----
# Public https URL the Mini App is served from. On Render this is filled in
# automatically from RENDER_EXTERNAL_URL, so you can leave it blank there.
# Locally, a Mini App needs a public https URL (e.g. an ngrok tunnel).
WEBAPP_URL=

# Set to 1 ONLY for local development to skip Telegram initData validation.
# Never enable this in production — it disables auth on the /api endpoints.
WEBAPP_ALLOW_INSECURE=
